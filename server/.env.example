# Copia este archivo a .env y rellena lo que necesites. NUNCA subas .env a Git.

# Puerto del servidor (el ESP32 y Codex apuntan aqui)
PORT=3000

# Carpeta donde se guardan lecturas (readings.jsonl) y estado (state.json)
DATA_DIR=./data

# --- Correo de alertas (opcional). Sin esto el servidor funciona, pero no envia correos ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Tu correo de Gmail
SMTP_USER=
# Contrasena de aplicacion de Google (16 letras), NO tu contrasena normal
SMTP_PASS=
# Quien recibe las alertas
ALERT_EMAIL_TO=
# Remitente (opcional; por defecto SMTP_USER)
ALERT_EMAIL_FROM=
